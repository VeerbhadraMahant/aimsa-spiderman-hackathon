# Copy this file to .env and fill in the values you have.
# The app runs fully in demo mode with NONE of these set — see README.md.

# --- Supabase (auth, database, realtime) ---
# From your Supabase project: Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- TomTom Maps (Campus Map page) ---
# From your TomTom developer dashboard: https://developer.tomtom.com/
VITE_TOMTOM_API_KEY=
